{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan-coder.local/schemas/workers.schema.json",
  "title": "plan-coder worker record",
  "description": "One worker run as the manager CLI reports it: the workers.json entry, normalised (issue #73, Phase 0). Version 1.",
  "schema": 1,
  "type": "object",
  "required": ["repo", "issue", "status"],
  "properties": {
    "run_id": {"type": ["string", "null"]},
    "repo": {"type": "string"},
    "issue": {"type": ["integer", "null"]},
    "branch": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "tier": {"type": ["string", "null"]},
    "tokens": {"type": ["integer", "null"]},
    "provider_used": {"type": ["string", "null"]},
    "workdir": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"]},
    "pr": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
