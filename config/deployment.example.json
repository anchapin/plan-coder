{
  "_about": "Deployment configuration for plan-coder. Copy this file to deployment.local.json in the same directory and fill in your real values. deployment.local.json is gitignored and is the version actually used: bin/agent.py reads it at startup (credential-helper labels, transcript directory) and bin/render_prompts.py renders the prompt templates in prompts/ with it into local/ (also gitignored). Search order for the config: $PLAN_CODER_CONFIG, then config/deployment.local.json relative to the repo root, then ~/.plan-coder/deployment.json. Every field is optional; built-in defaults cover a standalone env-key setup.",
  "operator": {
    "name": "Your Name",
    "flag_label": "NEEDS HUMAN"
  },
  "state": {
    "dir": "~/.plan-coder/state",
    "transcripts_dir": "~/.plan-coder/state/transcripts"
  },
  "worktrees": {
    "dir": "~/worktrees"
  },
  "repos": [
    {
      "name": "repo-a",
      "clone": "~/repos/repo-a",
      "slug": "you/repo-a",
      "base": "develop",
      "issues_per_cycle": 2,
      "skip_note": "<labels or topics to skip, with reason>",
      "brief_extra": ""
    },
    {
      "name": "repo-b",
      "clone": "~/repos/repo-b",
      "slug": "you/repo-b",
      "base": "main",
      "issues_per_cycle": 1
    }
  ],
  "supervisor": {
    "max_parallel": 6,
    "collect_deadline_hours": 2.5,
    "interval_hours": 2,
    "quota_context": "Quota is NOT the constraint; the human's merge bandwidth is. Mix quick wins and substantial issues as judgment dictates; small well-specified fixes merge fast.",
    "merge_order_example": "",
    "memory_note": "",
    "auth_note": ""
  },
  "workers": {
    "max_steps": 60,
    "provider_order": [
      "minimax",
      "zai"
    ]
  },
  "providers": {
    "zai": {
      "env_key": "ZAI_API_KEY",
      "credential": "custom.zai"
    },
    "minimax": {
      "env_key": "MINIMAX_API_KEY",
      "credential": "custom.minimax"
    }
  },
  "credentials": {
    "helper_dir": "~/.plan-coder/cred"
  },
  "shepherd": {
    "interval_minutes": 30,
    "trigger_cooldown_minutes": 30,
    "max_fix_attempts": 2,
    "trigger_note": "Adapt the trigger relay to your runner's mechanics.",
    "final_note": ""
  },
  "merge_policy": {
    "known_failures": "<required-checks drift>, <regression tracked in #NNNN>",
    "hard_stop_domain": "simulation/physics outputs",
    "directive_quote": "<your aggressive-merge directive, quoted>",
    "directive_date": "<YYYY-MM-DD>"
  },
  "tune": {
    "ideas_brief_file": "ideas-brief.md",
    "log_step": "Log what you changed and why to your ops log (one short section), including the publish result and the issue dispositions.",
    "flag_label": "[flag for human]"
  },
  "delivery": {
    "chat_id": "<chat-or-channel-id-if-your-runner-needs-one>"
  },
  "machine": {
    "build_note": "avoid heavy local builds beyond your machine's budget"
  },
  "skill": {
    "dir": "~/plan-coder-skill"
  },
  "public_repo": {
    "slug": "you/plan-coder",
    "local_clone": "~/plan-coder"
  },
  "crons": {
    "backlog-supervisor": {
      "title": "Backlog worker supervisor",
      "schedule": {
        "kind": "interval",
        "every": "2h",
        "timezone": "America/New_York"
      },
      "owner": "goal:<your-goal-slug>",
      "timeout_secs": 10800
    },
    "pr-shepherd": {
      "title": "PR shepherd (CI fix + merge watch)",
      "schedule": {
        "kind": "interval",
        "every": "30m",
        "timezone": "America/New_York"
      },
      "owner": "goal:<your-goal-slug>",
      "timeout_secs": 3600
    },
    "harness-tune": {
      "title": "Harness tuning (weekly)",
      "schedule": {
        "kind": "weekly",
        "dow": [
          "Sun"
        ],
        "time": "13:06:00",
        "timezone": "@user.current"
      },
      "owner": "goal:<your-goal-slug>",
      "timeout_secs": 86400
    }
  },
  "publish_gate": {
    "doc_sources": []
  }
}
