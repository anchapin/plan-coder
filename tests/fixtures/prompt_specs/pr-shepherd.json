{
  "prompt": "prompts/pr-shepherd.md",
  "note": "Behavioural specs for the PR shepherd prompt. Each spec is a small input state snippet (the PR as the shepherd sees it) plus the decision the prompt's own rules imply. The decision is computed by the deterministic rule engine in bin/prompt_check.py, gated on the clause of the prompt that states the rule; specs with deterministic=false need a model judgement and are excluded from the score.",
  "specs": [
    {
      "id": "merge_green_worker_branch",
      "description": "Green PR-specific CI, worker/* head, fresh SHA, diff reviewed, no flags -> merge.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "CLEAN",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": []
      },
      "expected_decision": "merge",
      "required_clauses": [
        "merge_requires_mergeable",
        "merge_requires_worker_branch",
        "merge_requires_fresh_sha",
        "merge_requires_diff_review",
        "merge_requires_no_flag",
        "no_jittest_merge",
        "no_tamper_merge",
        "merge_command"
      ],
      "deterministic": true
    },
    {
      "id": "merge_blocked_non_worker_branch",
      "description": "Green CI but the head branch is not worker/* -> never merge, leave for the operator.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "CLEAN",
        "head_branch": "main",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": []
      },
      "expected_decision": "flag",
      "required_clauses": ["merge_requires_worker_branch"],
      "deterministic": true
    },
    {
      "id": "merge_blocked_stale_sha",
      "description": "The head moved since the CI check ran -> do not merge this cycle, re-triage next cycle.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "CLEAN",
        "head_branch": "worker/issue-55",
        "head_sha_stale": true,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": []
      },
      "expected_decision": "hold_stale_sha",
      "required_clauses": ["merge_requires_fresh_sha"],
      "deterministic": true
    },
    {
      "id": "merge_unstable_known_failure_exempted",
      "description": "mergeStateStatus UNSTABLE but the only failures are pre-existing develop-wide issues already tracked in a follow-up -> must not block the merge.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "UNSTABLE",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": [{"scope": "pre_existing_tracked", "name": "develop-wide lint drift"}]
      },
      "expected_decision": "merge",
      "required_clauses": ["known_failure_exemption"],
      "deterministic": true
    },
    {
      "id": "merge_blocked_unstable_new_failure",
      "description": "mergeStateStatus UNSTABLE with a failure that is NOT a known pre-existing one -> do not merge.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "UNSTABLE",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": [{"scope": "pr_specific", "name": "new failing test"}]
      },
      "expected_decision": "flag",
      "required_clauses": ["known_failure_exemption"],
      "deterministic": true
    },
    {
      "id": "merge_blocked_workflow_touch",
      "description": "The PR touches .github/workflows -> workflow-touch hard stop, leave for the operator.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "CLEAN",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": true,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": []
      },
      "expected_decision": "flag",
      "required_clauses": ["hard_stop_workflows", "hard_stop_branch_protection"],
      "deterministic": true
    },
    {
      "id": "merge_blocked_jittest_catch",
      "description": "A catching JiTTest survived against the PR -> not merge-eligible, leave it for the operator.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "CLEAN",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": true,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": []
      },
      "expected_decision": "flag",
      "required_clauses": ["no_jittest_merge"],
      "deterministic": true
    },
    {
      "id": "flaky_ci_rerun_once",
      "description": "The failure is flaky/infra (runner died, timeout, rate limit) -> rerun once, no fix attempt.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "CLEAN",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "flaky",
        "ci_failures": [{"scope": "infra", "name": "runner died"}]
      },
      "expected_decision": "rerun",
      "required_clauses": ["rerun_once"],
      "deterministic": true
    },
    {
      "id": "conflicting_pr_skips_ci_fix",
      "description": "mergeable CONFLICTING -> report MERGE CONFLICTS and skip CI fixing this cycle.",
      "input": {
        "state": "open",
        "mergeable": "CONFLICTING",
        "merge_state_status": "UNKNOWN",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": []
      },
      "expected_decision": "merge_conflicts",
      "required_clauses": ["conflict_skip_ci"],
      "deterministic": true
    },
    {
      "id": "diff_scope_judgement",
      "description": "Is a 400-line refactor 'a well-scoped change with clear intent'? The prompt sets the bar in prose; no mechanical assertion can decide it.",
      "input": {
        "state": "open",
        "mergeable": "MERGEABLE",
        "merge_state_status": "CLEAN",
        "head_branch": "worker/issue-55",
        "head_sha_stale": false,
        "diff_reviewed": true,
        "flag_raised": false,
        "jittest_catch": false,
        "test_tamper_flag": false,
        "touches_workflows": false,
        "domain_judgment": false,
        "unverifiable": false,
        "ci": "green",
        "ci_failures": []
      },
      "expected_decision": "merge",
      "deterministic": false,
      "judgement_note": "needs a model judgement (diff scope review) -- excluded from the deterministic score, not faked"
    }
  ]
}
